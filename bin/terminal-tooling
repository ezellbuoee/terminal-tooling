#!/bin/bash
# Entry point for the Homebrew package: brew install ezellbuoee/terminal-tooling/terminal-tooling
#   terminal-tooling install [--skip L] [--only L]   install tools + configs (same as ./install.sh)
#   terminal-tooling configs       configs only, skip Homebrew (SKIP_BREW=1)
#   terminal-tooling version
set -euo pipefail
R="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
VERSION="$(cat "$R/VERSION" 2>/dev/null || echo dev)"

case "${1:-help}" in
  install) shift; exec "$R/install.sh" "$@" ;;
  configs) shift; SKIP_BREW=1 exec "$R/install.sh" "$@" ;;
  setup) exec "$R/setup.sh" ;;
  version|-v|--version) echo "terminal-tooling $VERSION" ;;
  help|-h|--help)
    cat <<USAGE
terminal-tooling $VERSION — Ghostty + Zellij + yazi + starship setup

usage: terminal-tooling <command> [--skip LIST] [--only LIST]
  install   install the tools (brew bundle) and copy the configs into ~
  configs   copy the configs only, skip Homebrew
  setup     choose wallpaper, number of panes and the sidebar tool (re-runnable)
  version   print the version

  --skip LIST   install everything except these units (comma-separated); the
                names are remembered in ~/.config/terminal-tooling/skip, one per
                line, and skipped on every later run (edit that file to re-enable)
  --only LIST   install just these units (ignores and never writes the skip file)

Units:
  shell                zsh hook + loader + modules
  zsh modules          omz tools ghostty fzf keys mouse yazi starship
  folders              ghostty-config zellij yazi-config nvim lazygit btop
                       starship-config wallpapers

Your own zsh additions go in ~/.config/terminal-tooling/local.zsh (never overwritten).
Files it replaces are backed up to ~/.config-backup-<timestamp>/.
Update: brew upgrade terminal-tooling && terminal-tooling configs
USAGE
    ;;
  *) echo "unknown command: $1 (try: terminal-tooling help)" >&2; exit 1 ;;
esac
